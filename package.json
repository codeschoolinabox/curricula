{
  "name": "@codeschoolinabox/spiralearn",
  "version": "0.1.0",
  "private": true,
  "description": "Curriculum content for codeschoolinabox — powered by Docusaurus",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:mdx && npm run lint:py && npm run lint:names && npm run lint:spelling",
    "typecheck": "tsc --noEmit",
    "lint:js": "eslint \"**/*.{js,mjs,jsx,ts,tsx}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:mdx": "eslint \"**/*.mdx\"",
    "lint:py": "ruff check .",
    "lint:names": "ls-lint",
    "lint:spelling": "cspell \"**/*.{md,mdx,js,mjs,ts,tsx,py,json}\" --no-progress",
    "format": "npm run format:js && npm run format:md && npm run format:mdx && npm run format:py",
    "format:js": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx}\"",
    "format:md": "prettier --write \"**/*.md\"",
    "format:mdx": "prettier --write \"**/*.mdx\"",
    "format:py": "ruff format .",
    "format:check": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,md,mdx,json}\"",
    "format:check:py": "ruff format --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:shard1": "vitest run --project browser --shard=1/3",
    "test:browser:shard2": "vitest run --project browser --shard=2/3",
    "test:browser:shard3": "vitest run --project browser --shard=3/3",
    "test:browser:parallel": "npm run test:browser:shard1 & npm run test:browser:shard2 & npm run test:browser:shard3 & wait",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run format:check && npm run format:check:py && npm run lint && npm run test",
    "prepare": "husky",
    "postinstall": "node scripts/check-ruff.mjs || true"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.mdx": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "acorn": "^8.16.0",
    "ajv": "^8.18.0",
    "aran": "^5.2.2",
    "astring": "^1.9.0",
    "codemirror": "^6.0.2",
    "estree-walker": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recast": "^0.23.11"
  },
  "devDependencies": {
    "@docusaurus/tsconfig": "^3.9.2",
    "@ls-lint/ls-lint": "^2.3.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.5.0",
    "@types/unist": "^3.0.3",
    "@vitest/browser": "^2.1.9",
    "cspell": "^9.7.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.1",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mdx": "^3.6.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.0.0",
    "markdownlint-cli2": "^0.21.0",
    "playwright": "^1.59.1",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "unist-util-visit": "^5.1.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codeschoolinabox/spiralearn"
  },
  "author": "@codeschoolinabox",
  "license": "MIT"
}
