{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git rev-parse:*)",
			"Bash(git ls-files:*)",
			"Bash(npx tsc --noEmit)",
			"Bash(npx cspell:*)",
			"Bash(npx markdownlint-cli2 --no-globs:*)",
			"Bash(./node_modules/.bin/vitest run --project unit:*)"
		],
		"deny": [
			"Bash(npx eslint --fix:*)",
			"Bash(git diff --output:*)",
			"Bash(git log --output:*)",
			"Bash(git show --output:*)",
			"Bash(npx markdownlint-cli2 --no-globs --fix:*)"
		]
	}
}
