{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git rev-parse:*)",
			"Bash(git ls-files:*)",
			"Bash(npx tsc --noEmit)",
			"Bash(npx cspell:*)",
			"Bash(npx eslint:*)",
			"Bash(npx markdownlint-cli2 --no-globs:*)",
			"Bash(./node_modules/.bin/vitest run --project unit:*)",
			"Bash(npm run test:hooks)"
		],
		"deny": [
			"Bash(npx eslint --fix:*)",
			"Bash(git diff --output:*)",
			"Bash(git log --output:*)",
			"Bash(git show --output:*)",
			"Bash(npx markdownlint-cli2 --no-globs --fix:*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/governance-guard.py"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/governance-advisory.py"
					}
				]
			}
		]
	}
}
